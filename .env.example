# Copy to .env and adjust. Never commit real credentials.

# HTTP listener
APP_HTTP_ADDR=:8080
APP_REQUEST_TIMEOUT=20s
APP_SHUTDOWN_GRACE=15s

# SQLite DSN. The required pragmas are added automatically when missing.
APP_DATABASE_DSN=file:data/orientation.db?_pragma=busy_timeout(10000)

# Observability
APP_LOG_LEVEL=info

# Identity
APP_SESSION_TTL=12h

# Campus timezone used by every enrollment deadline
APP_BUSINESS_TZ=Asia/Shanghai

# Background worker
APP_WORKER_ENABLED=true
APP_WORKER_POLL_INTERVAL=2s
APP_WORKER_LEASE=1m
APP_WORKER_BACKOFF_BASE=2s
APP_WORKER_BACKOFF_MAX=5m

# Optimistic seat allocation retry budget
APP_MAX_ENROLLMENT_RETRIES=4

# First start-up reference data
APP_SEED_DEMO_DATA=true
APP_SEED_TERM_CODE=2026-autumn
APP_SEED_REGISTRAR_EMAIL=registrar@campus.example
APP_SEED_REGISTRAR_PASSWORD=change-me-registrar
APP_SEED_STUDENT_EMAIL=student@campus.example
APP_SEED_STUDENT_PASSWORD=change-me-student
